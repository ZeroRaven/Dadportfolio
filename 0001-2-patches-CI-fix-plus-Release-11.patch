+              <div className="mt-1.5 flex items-center gap-2">
+                <Input
+                  type="number" min={20} max={40} step={0.5} inputMode="decimal"
+                  value={clr}
+                  onChange={(e) => setClr(e.target.value)}
+                  className="text-right font-bold"
